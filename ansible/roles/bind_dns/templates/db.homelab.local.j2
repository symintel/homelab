$TTL    300
@       IN      SOA     ns.homelab.local. root.homelab.local. (
                   {{ '%Y%m%d01' | strftime }}           ; Serial
                          300           ; Refresh [5m]
                          150           ; Retry   [2.5m]
                         3600           ; Expire  [1h]
                          600 )         ; Negative Cache TTL [1h]
;
@       IN      NS      ns.homelab.local.

ns      IN      A       {{ dns_primary }}
incus   IN      A       {{ hostvars[incus_cluster_leader].static_ip }}

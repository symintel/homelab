---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-vip-ds
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kube-vip-ds
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kube-vip-ds
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: Exists
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
      serviceAccountName: kube-vip
      hostNetwork: true
      containers:
        - name: kube-vip
          image: ghcr.io/kube-vip/kube-vip:{{ k3s_install.kube_vip.image_version }}
          imagePullPolicy: IfNotPresent
          args:
            - manager
          env:
            - name: cp_enable
              value: "true"
            - name: svc_enable
              value: "false"
            - name: vip_leaderelection
              value: "true"
            - name: vip_interface
              value: "{{ k3s_install.kube_vip.interface }}"
            - name: address
              value: "{{ k3s_install.kube_vip.address }}"
            - name: port
              value: "6443"
            - name: vip_cidr
              value: "32"
{% if k3s_install.kube_vip.mode == 'arp' %}
            - name: vip_arp
              value: "true"
{% elif k3s_install.kube_vip.mode == 'bgp' %}
            - name: bgp_enable
              value: "true"
            - name: bgp_routerid
              value: "{{ k3s_install.kube_vip.bgp.routerid | default('192.168.20.5') }}"
            - name: bgp_as
              value: "{{ k3s_install.kube_vip.bgp.as | default('64512') }}"
            - name: bgp_peers
              value: "{{ k3s_install.kube_vip.bgp.peers | default('192.168.20.1:64512') }}"
{% endif %}
          securityContext:
            capabilities:
              add:
                - NET_ADMIN
                - NET_RAW

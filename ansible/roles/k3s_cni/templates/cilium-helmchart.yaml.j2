apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  repo: https://helm.cilium.io
  chart: cilium
  version: "{{ k3s_cni_cilium_version | regex_replace('^v', '') }}"
  targetNamespace: kube-system
  valuesContent: |-
    operator:
      replicas: 1
    ipam:
      mode: kubernetes
